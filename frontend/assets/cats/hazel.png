<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
    <defs>
      <radialGradient id="bg_Hazel" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fff5eb"/>
        <stop offset="100%" stop-color="#fee3d0"/>
      </radialGradient>
      <filter id="shadow">
        <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.15"/>
      </filter>
    </defs>
    <circle cx="100" cy="100" r="90" fill="url(#bg_Hazel)" />
    <!-- Ears -->
    <polygon points="55,50 75,90 40,80" fill="#9c6644" filter="url(#shadow)"/>
    <polygon points="60,55 72,85 45,78" fill="#ffb7b2"/>
    <polygon points="145,50 125,90 160,80" fill="#9c6644" filter="url(#shadow)"/>
    <polygon points="140,55 128,85 155,78" fill="#ffb7b2"/>
    <!-- Head -->
    <ellipse cx="100" cy="105" rx="50" ry="42" fill="#9c6644" filter="url(#shadow)"/>
    <!-- Cheeks / Muzzle -->
    <ellipse cx="88" cy="115" rx="14" ry="10" fill="#ddb892"/>
    <ellipse cx="112" cy="115" rx="14" ry="10" fill="#ddb892"/>
    <polygon points="100,110 95,105 105,105" fill="#e07a5f"/>
    <!-- Eyes -->
    <ellipse cx="78" cy="98" rx="7" ry="9" fill="#2b2d42"/>
    <ellipse cx="122" cy="98" rx="7" ry="9" fill="#2b2d42"/>
    <circle cx="76" cy="95" r="2.5" fill="#ffffff"/>
    <circle cx="120" cy="95" r="2.5" fill="#ffffff"/>
    <!-- Whiskers -->
    <line x1="50" y1="110" x2="70" y2="112" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
    <line x1="48" y1="118" x2="68" y2="117" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
    <line x1="150" y1="110" x2="130" y2="112" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
    <line x1="152" y1="118" x2="132" y2="117" stroke="#6c757d" stroke-width="2" stroke-linecap="round"/>
    <!-- Accessory symbol -->
    <text x="100" y="165" font-family="sans-serif" font-size="20" text-anchor="middle">☕</text>
  </svg>