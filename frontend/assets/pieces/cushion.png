<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
    <defs>
      <linearGradient id="pbg_cushion" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f0f7f4"/>
        <stop offset="100%" stop-color="#e2ece9"/>
      </linearGradient>
      <filter id="shadow">
        <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.12"/>
      </filter>
    </defs>
    <rect x="10" y="10" width="180" height="180" rx="30" fill="url(#pbg_cushion)" stroke="#c8d6e5" stroke-width="2"/>
    <circle cx="100" cy="90" r="50" fill="#e9c46a" filter="url(#shadow)"/>
    <text x="100" y="105" font-family="sans-serif" font-size="42" text-anchor="middle" fill="#ffffff">🛋️</text>
    <text x="100" y="160" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle" fill="#2d3748">Cozy Cushion</text>
  </svg>